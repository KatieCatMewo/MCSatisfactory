{
  "schemaVersion": 1,
  "id": "mcsatisfactory",
  "version": "${version}",
  "name": "MC Satisfactory",
  "description": "a mod that aims to add the entirety of Satisfactory to Minecraft",
  "authors": [],
  "contact": {},
  "license": "MIT",
  "icon": "assets/mcsatisfactory/icon.png",
  "environment": "*",
  "entrypoints": {
    "fabric-datagen": [
      "net.kittykat.mcsatisfactory.datagen.MCSatisfactoryDataGenerator"
    ],
    "client": [
      "net.kittykat.mcsatisfactory.MCSatisfactoryClient"
    ],
    "main": [
      "net.kittykat.mcsatisfactory.MCSatisfactory"
    ],
    "cardinal-components": [
      "net.kittykat.mcsatisfactory.components.entity.ModEntityComponents",
      "net.kittykat.mcsatisfactory.components.item.ModItemComponents"
    ]
  },
  "mixins": [
    "mcsatisfactory.mixins.json",
    {
      "config": "mcsatisfactory.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric": "*",
    "minecraft": "${minecraft_version}"
  },
  "custom": {
    "cardinal-components": [
      "mcsatisfactory:preferred_fuel",
      "mcsatisfactory:jetpack_data",
      "mcsatisfactory:rebar_gun_data",
      "mcsatisfactory:rifle_data"
    ]
  }
}
